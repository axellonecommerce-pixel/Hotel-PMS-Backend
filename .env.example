# InnSeva PMS backend (Vercel). Names only; never commit real values.
# Local development: copy to .env.local and fill in the TEST Supabase project.
# Production values live only in Vercel › Project › Settings › Environment Variables.

# Database: Supabase transaction pooler (port 6543)
DATABASE_URL=

# Supabase (server side only; the secret key must never reach the browser)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
PMS_PRIVATE_BUCKET=

# Browser origins allowed to call this API (comma separated)
PMS_FRONTEND_ORIGINS=

# Platform admins (comma-separated emails)
PMS_PLATFORM_ADMIN_EMAILS=

# Secrets: long random values
CRON_SECRET=
PMS_ENCRYPTION_KEY=

# Local development only. Ignored when NODE_ENV=production.
PMS_DEMO_AUTH_ENABLED=
PMS_DEMO_AUTH_TOKEN=
PMS_DEMO_AUTH_USER_ID=
