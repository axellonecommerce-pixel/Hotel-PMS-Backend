{
  "name": "hotel-pms-backend-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "typecheck": "NODE_OPTIONS=--max-old-space-size=1024 tsc --noEmit",
    "test": "bun test",
    "test:rls": "bun --env-file=.env.local scripts/verify-rls.ts",
    "db:generate": "drizzle-kit generate",
    "db:generate:production": "drizzle-kit generate --config drizzle.production.config.ts",
    "db:migrate": "mkdir -p data && drizzle-kit migrate",
    "db:seed": "tsx src/server/db/seed.ts",
    "db:reset": "rm -f data/sun-star-demo-v3.sqlite && bun run db:migrate && bun run db:seed"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "next": "16.3.3",
    "postgres": "^3.4.9",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/bun": "^1.4.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
